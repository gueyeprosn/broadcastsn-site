# Alertes courriel des demandes de devis.
# Copier en mail.env (chmod 600), renseigner, puis : ./deploy.sh && ./test-mail.sh
#
# Exemples de serveurs :
#   Gmail / Google Workspace : smtp.gmail.com, port 465, mot de passe d'application
#   Brevo                    : smtp-relay.brevo.com, port 587
#   Resend                   : smtp.resend.com, port 465, SMTP_USER=resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Destinataire(s) des alertes, séparés par des virgules
DEVIS_MAIL_TO=
# Expéditeur (facultatif, défaut : SMTP_USER) — doit être autorisé par le service
DEVIS_MAIL_FROM=
