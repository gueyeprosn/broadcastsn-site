# Nom canonique du site : seul endroit à modifier pour changer de domaine.
# Après modification : ./render-vhosts.sh puis ./enable-tls.sh
DOMAIN=sn.broadcastsn.com

# Noms supplémentaires servis par le même vhost et inclus dans le certificat
# (séparés par des espaces, vide par défaut). Les requêtes y arrivant sont
# redirigées vers DOMAIN une fois TLS actif.
# Exemple si l'apex devient disponible : ALT_NAMES="broadcastsn.com www.broadcastsn.com"
ALT_NAMES=""
